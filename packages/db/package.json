{
  "name": "@plataforma-csa/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "lint": "echo \"no lint configured yet\"",
    "db:generate-auth-schema": "dotenv -e ../../.env -- npx @better-auth/cli generate --config src/auth.ts --output src/schema/auth.ts -y",
    "db:push": "dotenv -e ../../.env -- drizzle-kit push --config drizzle.config.ts"
  },
  "dependencies": {
    "better-auth": "^1.3.34",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.3.34",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
